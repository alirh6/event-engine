# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# PostgreSQL (defaults match docker-compose.yml)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://event_engine:event_engine@localhost:5432/event_engine?schema=public&connection_limit=20&pool_timeout=10

# ---------------------------------------------------------------------------
# Redis Streams (defaults match docker-compose.yml)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_STREAM_NAME=events:stream
REDIS_STREAM_MAX_LENGTH=1000000
REDIS_CONSUMER_GROUP=engine-workers
REDIS_CONSUMER_NAME=worker-1
REDIS_CONSUMER_BATCH_SIZE=100
REDIS_CONSUMER_BLOCK_MS=2000
REDIS_CONSUMER_RECLAIM_IDLE_MS=60000
REDIS_CONSUMER_RECLAIM_INTERVAL_MS=15000
REDIS_MAX_DELIVERY_ATTEMPTS=5

# ---------------------------------------------------------------------------
# HTTP surface
# ---------------------------------------------------------------------------
# Comma-separated list of allowed origins, or * to allow all.
CORS_ORIGINS=*
RATE_LIMIT_MAX=10000

# ---------------------------------------------------------------------------
# Docker compose infrastructure
# ---------------------------------------------------------------------------
POSTGRES_USER=event_engine
POSTGRES_PASSWORD=event_engine
POSTGRES_DB=event_engine
POSTGRES_PORT=5432
REDIS_PORT=6379
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
